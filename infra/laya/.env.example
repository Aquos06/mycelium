# copy to .env on the box that runs Laya

LAYA_PORT=8100            # host port; the gateway's LAYA_ENDPOINT points here
LAYA_DEVICE=cuda          # cpu when there is no NVIDIA GPU (then start without docker-compose.gpu.yml)
LAYA_PRELOAD=1            # load checkpoints at start

# Optional bearer token. laya-serve turns auth on as soon as this variable exists, even empty, so keep the
# line out (or commented) for an open server on the LAN; set the same value as LAYA_API_KEY in the brain's .env.
# LAYA_API_KEY=change-me

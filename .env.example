# copy to .env and fill in

# stack name namespaces containers, networks, volumes and module images,
# so dev / staging / production can run side by side on one Docker host
STACK=mycelium
NATS_PORT=4222
NATS_MON_PORT=8222
PG_PORT=5432

POSTGRES_PASSWORD=change-me
LOG_LEVEL=INFO

# what "today" means for memory and Main (MAIN_TZ defaults to MEMORY_TZ); seconds Main waits per planner round
MEMORY_TZ=Asia/Taipei
MAIN_LLM_TIMEOUT=90
# local time of memory's nightly consolidation (needs a model: the `consolidate` slot in providers.yaml); empty = off
MEMORY_CONSOLIDATE_AT=03:30

# Claude: the gateway's planner and the builder (Claude Agent SDK). Console API key, not a claude.ai login.
ANTHROPIC_API_KEY=

# other model vendors, one key per kind you enable in services/gateway/providers.yaml (ollama / vllm need none)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# which provider answers each slot in services/gateway/providers.yaml (claude when empty): vllm, ollama, openai, ...
PLANNER_PROVIDER=
CONSOLIDATE_PROVIDER=
EMBED_PROVIDER=

# local models: docker compose --profile local (ollama) / --profile gpu (vllm). A vLLM elsewhere on the LAN:
# VLLM_ENDPOINT=http://192.168.0.107:8000/v1 and VLLM_MODEL=<the id GET /v1/models returns>
OLLAMA_CONTEXT_LENGTH=16384
VLLM_ENDPOINT=
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# embeddings: TEI from infra/embed/ on the GPU box, e.g. http://192.168.0.107:8101/v1
TEI_ENDPOINT=
# MEMORY_EMBED=false turns memory's vectors off; MEMORY_EMBED_EVERY=10 is the sweep interval in minutes

# run the builder as you so generated files are yours: `id -u` / `id -g`
HOST_UID=1000
HOST_GID=1000

# comma-separated modules you reviewed and allow to act on the real world
APPROVED_ACTUATORS=

# telegram bridge (docker compose --profile telegram up -d)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# images: local builds by default; CD sets these to ghcr.io/<owner>/mycelium and the git sha
REGISTRY=mycelium
IMAGE_TAG=dev

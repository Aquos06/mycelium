# copy to .env and fill in

# stack name namespaces containers, networks, volumes and module images,
# so dev / staging / production can run side by side on one Docker host
STACK=mycelium
NATS_PORT=4222
NATS_MON_PORT=8222
PG_PORT=5432

POSTGRES_PASSWORD=change-me
LOG_LEVEL=INFO

# what "today" means for memory and Main (MAIN_TZ defaults to MEMORY_TZ); seconds Main waits per planner round
MEMORY_TZ=Asia/Taipei
MAIN_LLM_TIMEOUT=90

# Claude: the gateway's planner and the builder (Claude Agent SDK). Console API key, not a claude.ai login.
ANTHROPIC_API_KEY=

# other model vendors, one key per kind you enable in services/gateway/providers.yaml (ollama / vllm need none)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# local models: docker compose --profile local (ollama) / --profile gpu (vllm)
OLLAMA_CONTEXT_LENGTH=16384
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct

# run the builder as you so generated files are yours: `id -u` / `id -g`
HOST_UID=1000
HOST_GID=1000

# comma-separated modules you reviewed and allow to act on the real world
APPROVED_ACTUATORS=

# telegram bridge (docker compose --profile telegram up -d)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# images: local builds by default; CD sets these to ghcr.io/<owner>/mycelium and the git sha
REGISTRY=mycelium
IMAGE_TAG=dev

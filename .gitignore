grown/
.env
.env.*
!.env.example
*.sqlite3
.DS_Store

# node / pnpm, anywhere in the tree (frontend/.gitignore covers the Next.js build output itself)
node_modules/
.pnpm-store/
.pnpm/
.pnpm-debug.log*
.npm/
# pnpm-lock.yaml is committed on purpose: CI and the image install with --frozen-lockfile
